@model Garage3.Models.ViewModels.ParkedVehicleEditViewModel

@{
    ViewData["Title"] = "Edit Vehicle";
}

<h1>Edit Vehicle</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<h4>Parked Vehicle</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Arrival" />

            <div class="form-group mb-3">
                <label asp-for="VehicleTypeId" class="control-label fw-bold"></label>
                <select asp-for="VehicleTypeId" asp-items="Model.VehicleTypes" class="form-select">
                </select>
                <span asp-validation-for="VehicleTypeId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="RegNbr" class="control-label fw-bold"></label>
                <input asp-for="RegNbr" class="form-control" />
                <span asp-validation-for="RegNbr" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Color" class="control-label fw-bold"></label>
                <input asp-for="Color" class="form-control" maxlength="10" />
                <span asp-validation-for="Color" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Brand" class="control-label fw-bold"></label>
                <input asp-for="Brand" class="form-control" maxlength="20" />
                <span asp-validation-for="Brand" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Model" class="control-label fw-bold"></label>
                <input asp-for="Model" class="form-control" maxlength="10" />
                <span asp-validation-for="Model" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Wheels" class="control-label fw-bold"></label>
                <input asp-for="Wheels" class="form-control"/>
                <span asp-validation-for="Wheels" class="text-danger"></span>
            </div>
            <div class="form-group mt-4">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="MyVehicles" class="btn btn-secondary ms-2">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
