@model Garage3.Models.ViewModels.ParkVehicleViewModel

@{
    ViewData["Title"] = "Park Vehicle";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Park Vehicle</h4>
            </div>

            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="VehicleId" class="form-label"></label>

                        <select asp-for="VehicleId"
                                asp-items="Model.Vehicles"
                                class="form-select">
                            <option value="">-- Select Vehicle --</option>
                        </select>

                        <span asp-validation-for="VehicleId" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="ParkingSpotId" class="form-label"></label>

                        <select asp-for="ParkingSpotId"
                                asp-items="Model.ParkingSpots"
                                class="form-select">
                            <option value="">-- Select Parking Spot --</option>
                        </select>

                        <span asp-validation-for="ParkingSpotId" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="MyVehicles"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-primary">
                            Park Vehicle
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}