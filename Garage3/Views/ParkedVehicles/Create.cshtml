@model ParkVehicleViewModel

@{
    ViewData["Title"] = "Park vehicle";
}

<h1>Park vehicle</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<h4>Enter Vehicle Details</h4>
<hr />
<br />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="VehicleTypeId" class="control-label"></label>
                <select asp-for="VehicleTypeId" asp-items="Model.VehicleTypes" class="form-select">
                    <option value="">-- Select Vehicle type --</option>
                </select>
                <span asp-validation-for="VehicleTypeId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="RegNbr" class="control-label"></label>
                <input asp-for="RegNbr" class="form-control" placeholder="e.g. ABC123" />
                <span asp-validation-for="RegNbr" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Color" class="control-label"></label>
                <input asp-for="Color" class="form-control" />
                <span asp-validation-for="Color" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Brand" class="control-label"></label>
                <input asp-for="Brand" class="form-control" />
                <span asp-validation-for="Brand" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Model" class="control-label"></label>
                <input asp-for="Model" class="form-control" />
                <span asp-validation-for="Model" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Wheels" class="control-label"></label>
                <input asp-for="Wheels" class="form-control" />
                <span asp-validation-for="Wheels" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Park Vehicle" class="btn btn-primary" />
                <a asp-action="MyVehicles" class="btn btn-secondary ms-2">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}