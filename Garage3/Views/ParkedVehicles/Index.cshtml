
@model IEnumerable<ParkedVehicleOverviewViewModel>

@{
    ViewData["Title"] = "Parked Vehicles";
    string currentSearch = ViewData["CurrentFilter"]?.ToString() ?? "";
}

<h1>Parked Vehicles</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<!-- Display error message if the user tries to access a non-existing vehicle ID -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Park New Vehicle</a>
</p>

<!-- SEARCH -->

<form asp-controller="ParkedVehicles" asp-action="Index" method="get" class="form-inline mb-3">
    <div class="input-group">
        <input type="text" 
               name="searchRegNbr" 
               value="@currentSearch"
               class="form-control" 
               placeholder="Filter by registration number"
                required
                oninvalid="this.setCustomValidity('You need to enter a registration number.')"
                oninput="this.setCustomValidity('')" />
                

        <div class="input-group-append">
            @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
            {
                <!-- Exit to clear search and view all vehicles -->
                <a asp-action="Index"
                class="btn btn-outline-secondary" 
                title="Clear search">&times;</a>
            }
            <button type="submit" 
                    class="btn btn-primary">Search</button>
        </div>
    </div>
</form>

@if (ViewData["Exists"] != null)
{
    if (ViewData["Exists"] as bool? == true)
    {
        <div class="alert alert-success mt-3" role="alert">
            <strong>Hit!</strong> Vehicle(s) with registration number <strong>@ViewData["CurrentFilter"]</strong> is displayed below.
        </div>
    }
    else
    {
        <div class="alert alert-warning mt-3" role="alert">
            <strong>No hit!</strong> Registration number <strong>@ViewData["CurrentFilter"]</strong> does not exist. Full list of vehicles is displayed instead.
        </div>
    }
}

<table class="table">
    <thead>
        <tr>
            <th>Vehicle Type</th>
            <th>Registration Number</th>

            @if (!string.IsNullOrEmpty(currentSearch))
            {
                <th>Brand</th>
                <th>Model</th>
                <th>Color</th>
                <th>Wheels</th>
            }
            <th>Arrival Time</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.VehicleType)
            </td>
            <td>
                @Html.DisplayFor(model => item.RegNbr)
            </td>
                @if (!string.IsNullOrEmpty(currentSearch))
                {
                    <td>
                        @Html.DisplayFor(model => item.Brand)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Model)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Color)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Wheels)
                    </td>
                }
            <td>
                @Html.DisplayFor(model => item.Arrival)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Checkout" asp-route-id="@item.Id">Checkout</a>
            </td>
        </tr>
}
    </tbody>
</table>