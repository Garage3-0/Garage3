@model ParkedVehicle

@{
    ViewData["Title"] = "Vehicle Details";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-dark d-flex justify-content-between align-items-center py-3">
                <h4 class="mb-0 fs-5 fw-bold">Vehicle Details</h4>
                <span class="badge bg-dark fs-6 font-monospace">@Model?.RegNbr</span>
            </div>

            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted mb-2">Registration Number</dt>
                    <dd class="col-sm-7 fw-bold mb-2">@Model?.RegNbr</dd>

                    <dt class="col-sm-5 text-muted mb-2">Vehicle Type</dt>
                    <dd class="col-sm-7 mb-2">@(Model?.VehicleType?.Name ?? "N/A")</dd>

                    <dt class="col-sm-5 text-muted mb-2">Brand</dt>
                    <dd class="col-sm-7 mb-2">@Model?.Brand</dd>

                    <dt class="col-sm-5 text-muted mb-2">Model</dt>
                    <dd class="col-sm-7 mb-2">@Model?.Model</dd>

                    <dt class="col-sm-5 text-muted mb-2">Color</dt>
                    <dd class="col-sm-7 mb-2">@Model?.Color</dd>

                    <dt class="col-sm-5 text-muted mb-2">Number of Wheels</dt>
                    <dd class="col-sm-7 mb-2">@Model?.Wheels</dd>

                    <dt class="col-sm-5 text-muted mb-2">Arrival Time</dt>
                    <dd class="col-sm-7 mb-2">@Model?.Arrival.ToString("yyyy-MM-dd HH:mm")</dd>
                </dl>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <a asp-action="MyVehicles" class="btn btn-outline-secondary">Back to List</a>
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning fw-bold px-4">Edit Vehicle</a>
                </div>
            </div>
        </div>
    </div>
</div>