@model ParkedVehicle

@{
    ViewData["Title"] = "Vehicle Details";
}

<h1>Vehicle Details</h1>

<div>
    <h4>Parked Vehicle</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Registration Number</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.RegNbr)</dd>

        <dt class="col-sm-2">Vehicle Type</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.VehicleType)</dd>

        <dt class="col-sm-2">Color</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Color)</dd>

        <dt class="col-sm-2">Brand</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Brand)</dd>

        <dt class="col-sm-2">Model</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Model)</dd>

        <dt class="col-sm-2">Wheels</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Wheels)</dd>

        <dt class="col-sm-2">Arrival Time</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Arrival)</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to Parked Vehicles</a>
</div>