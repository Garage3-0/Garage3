@model Garage3.Models.ViewModels.RegisterVehicleViewModel

@{
    ViewData["Title"] = "Register Vehicle";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Register New Vehicle</h4>
            </div>
            <div class="card-body">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="VehicleTypeId" class="form-label"></label>
                        <select asp-for="VehicleTypeId" asp-items="Model.VehicleTypes" class="form-select">
                            <option value="">-- Select Vehicle Type --</option>
                        </select>
                        <span asp-validation-for="VehicleTypeId" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="RegNbr" class="form-label"></label>
                        <input asp-for="RegNbr" class="form-control" placeholder="e.g. ABC123" />
                        <span asp-validation-for="RegNbr" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Brand" class="form-label"></label>
                        <input asp-for="Brand" class="form-control" />
                        <span asp-validation-for="Brand" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Model" class="form-label"></label>
                        <input asp-for="Model" class="form-control" />
                        <span asp-validation-for="Model" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Color" class="form-label"></label>
                        <input asp-for="Color" class="form-control" />
                        <span asp-validation-for="Color" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Wheels" class="form-label"></label>
                        <input asp-for="Wheels" class="form-control" type="number" />
                        <span asp-validation-for="Wheels" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="MyVehicles" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success">Register Vehicle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}