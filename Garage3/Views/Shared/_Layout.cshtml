@using Garage3.Constants
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Garage 3</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Garage_3._0.styles.css" asp-append-version="true" />
</head>
<body style="display: grid; grid-template-rows: max-content 1fr max-content; height: 100vh;">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3 text-white" style="margin-bottom: 50px !important; background-color: #626298 !important;">
            <div class="container" style="align-items: flex-end;">
                <a class="navbar-brand text-white" asp-area="" asp-controller="ParkedVehicles" asp-action="Index" style="font-size: 30px; font-weight: bold; font-style: italic; /*text-shadow: 2px 3px 3px #1d1d1d;*&Y">Garage 3</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
@*                         <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="ParkedVehicles" asp-action="Index">Parked vehicles</a>
                        </li> *@

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item text-white">
                                <a class="nav-link text-white active" asp-controller="ParkedVehicles" asp-action="MyVehicles">My Vehicles</a>
                            </li>
                        }
                        @if (User.IsInRole(Roles.Admin))
                        {
                            <li class="nav-item text-white">
                                <a class="nav-link text-white" asp-controller="Admin" asp-action="Users">Admin</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-light" style="background-color: #626298 !important; padding-bottom: 4px; text-align: center;">
        <div class="container">
            &copy; 2026 - Garage 3 - Webmaster: Group 1
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
