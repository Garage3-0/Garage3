@* @model (Garage3.Data.ApplicationUser User, IList<string> Roles) *@
@model Garage3.Models.ViewModels.AdminUserViewModel

@{
    ViewData["Title"] = "User Details";
}

<h1>User Details</h1>

<div>
    <dl class="=" row">
        <dt class="=" col-sm-3">Username</dt>
        <dd class="col-sm-9">@Model.User.UserName</dd>

        <dt class="=" col-sm-3">First name</dt>
        <dd class="col-sm-9">@Model.User.FirstName</dd>

        <dt class="=" col-sm-3">Last name</dt>
        <dd class="col-sm-9">@Model.User.LastName</dd>

        <dt class="=" col-sm-3">Personal identity number</dt>
        <dd class="col-sm-9">@Model.User.PersonalIdentityNumber</dd>

        <dt class="=" col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.User.Email</dd>

        <dt class="=" col-sm-3">Roles</dt>
        <dd class="col-sm-9">
            @if (Model.Roles.Any())
            {
                @string.Join(", ", Model.Roles)
            }
            else
            {
                <span>No roles assigned</span>
            }
        </dd>
    </dl>
</div>

<hr />

<h2>Manage Roles</h2>

<h3>Current Roles</h3>

@if (Model.Roles.Any())
{
    <ul>
        @foreach (var role in Model.Roles)
        {
            <li>
                @role

                <form asp-action="RemoveRole"
                      method="post"
                      style="display:inline;">
                    <input type="hidden"
                           name="userId"
                           value="@Model.User.Id" />

                    <input type="hidden"
                           name="role"
                           value="@role" />

                    <button type="submit"
                           class="btn btn-sm btn-danger">
                       Remove
                   </button>
                </form>
            </li>
        }
    </ul>
}
else
{
    <p>This user has no roles.</p>
}

<h3>Add Role</h3>

<form asp-action="AddRole" method="post">
    <input type="hidden"
        name="userId"
        value="@Model.User.Id" />

    <select name="role" class="form-select">
        @foreach (var role in Model.AvailableRoles)
            {
                <option value="@role">@role</option> 
            }
    </select>

    <button type="submit" class="btn btn-primary mt-2">
        Add Role
    </button>
</form>

<div class="mt-3">
    <a asp-action="Users" class="btn btn-secondary">
        Back to users
        </a>
    </div>