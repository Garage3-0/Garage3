@model Garage_3._0.Models.ViewModels.ParkedVehicleEditViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<h4>Parked Vehicle</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="VehicleType" class="control-label fw-bold"></label>
                <select asp-for="VehicleType"
                        asp-items="Html.GetEnumSelectList<VehicleType>()">
                </select>
                <span asp-validation-for="VehicleType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RegNbr" class="control-label fw-bold"></label>
                <input asp-for="RegNbr" class="form-control" />
                <span asp-validation-for="RegNbr" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Color" class="control-label fw-bold"></label>
                <input asp-for="Color" class="form-control" maxlength="10" />
                <span asp-validation-for="Color" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Brand" class="control-label fw-bold"></label>
                <input asp-for="Brand" class="form-control" maxlength="20" />
                <span asp-validation-for="Brand" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Model" class="control-label fw-bold"></label>
                <input asp-for="Model" class="form-control" maxlength="10" />
                <span asp-validation-for="Model" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Wheels" class="control-label fw-bold"></label>
                <input asp-for="Wheels" class="form-control"/>
                <span asp-validation-for="Wheels" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Arrival" class="control-label fw-bold"></label>
                <p class="form-control-plaintext">@Model.Arrival.ToString("yyyy-MM-dd HH:mm")</p>
                <input type="hidden" asp-for="Arrival" />
                <small class="form-text text-muted">Arrival time cannot be edited.</small>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
