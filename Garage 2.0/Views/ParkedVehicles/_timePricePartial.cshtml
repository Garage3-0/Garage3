@using System.Text
@model Garage_2._0.Models.ViewModels.ReceiptViewModel
@{
    //Create parked time as string
    StringBuilder strTime = new StringBuilder();
    if (Model.ParkedDays > 0)
        strTime.Append(Model.ParkedDays + " days ");
    if (Model.ParkedHours > 0)
        strTime.Append(Model.ParkedHours + " h ");
    if (Model.ParkedMinutes > 0)
        strTime.Append(Model.ParkedMinutes + " m");
    
    if(strTime.Length <= 0)
        strTime.Append("0 minutes");
}

<dl class="row">
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Arrival)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Arrival)
    </dd>
</dl>
<dl class="row">
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.CheckoutTime)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.CheckoutTime)
    </dd>
</dl>
<dl class="row">
    <dt class="col-sm-2">
        Parked time
    </dt>
    <dd class="col-sm-10">
        @strTime
    </dd>
</dl>
<dl class="row">
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Price)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Price) kr (@Html.DisplayFor(model => model.PricePerHour) kr/hour)
    </dd>
</dl>
