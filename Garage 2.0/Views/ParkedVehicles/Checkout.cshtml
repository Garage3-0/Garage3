@model Garage_2._0.Models.ParkedVehicle

@{
    ViewData["Title"] = "Checkout";
}

<h1>Checkout vehicle</h1>
<div>
    <hr />
    <h4 class="mb-3">Do you want to checkout this vehicle?</h4>
    
    <dl class="row">
        <dt class = "col-sm-3">
            @Html.DisplayNameFor(model => model.RegNbr)
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.RegNbr)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-3">
            @Html.DisplayNameFor(model => model.Brand)
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.Brand)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-3">
            @Html.DisplayNameFor(model => model.Model)
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.Model)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Color)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Color)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.VehicleType)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.VehicleType)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Wheels)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Wheels)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-3">
            @Html.DisplayNameFor(model => model.Arrival)
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.Arrival)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-3">
            Checkout time
        </dt>
        <dd class="col-sm-9">
            @ViewBag.timeNow
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-3">
            Parked time
        </dt>
        <dd class="col-sm-9">
            @ViewBag.totalTimeString
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-3">
            Price
        </dt>
        <dd class="col-sm-9">
            @ViewBag.price <span> kr</span>
        </dd>
    </dl>
