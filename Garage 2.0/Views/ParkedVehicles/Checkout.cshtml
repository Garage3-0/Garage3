@model Garage_2._0.Models.ReceiptViewModel

@{
    ViewData["Title"] = "Checkout";
}

<h1>Checkout vehicle</h1>
<div>
    <hr />
    <h4 class="mb-3">Do you want to checkout this vehicle?</h4>
    
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.RegNbr)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RegNbr)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Brand)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Brand)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Model)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Model)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Color)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Color)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.VehicleType)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.VehicleType)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Wheels)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Wheels)
        </dd>
    </dl>
       
    <partial name="_timePricePartial" />

    <form asp-action="Receipt">
        <input type="hidden" asp-for="Id" />
        <dl class="row">
            <dd class="col-sm-2">
                <input type="submit" value="Checkout vehicle" class="btn btn-danger" />
            </dd>
            <dd class="col-sm-10">
                <a asp-action="Index">Back to List</a>
            </dd>
        </dl>
    </form>
</div>
