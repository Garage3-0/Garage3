@model IEnumerable<Garage_2._0.ViewModels.ParkedVehicleOverviewViewModel>

@{
    ViewData["Title"] = "Parked Vehicles";
}

<h1>Parked Vehicles</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Park New Vehicle</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Vehicle Type</th>
            <th>Registration Number</th>
            <th>Arrival Time</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.VehicleType</td>
                <td>@item.RegNbr</td>
                <td>@item.Arrival</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Check Out</a>
                </td>
            </tr>
        }
    </tbody>
</table>